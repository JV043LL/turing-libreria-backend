{
  "info": {
    "name": "Turing Librería API",
    "description": "API REST de la librería en línea (periodo de prueba Turing-IA).\n\n1. Ejecuta **Auth > Login admin** (o Login user): el token se guarda solo en la variable `token`.\n2. Las peticiones protegidas usan `Bearer {{token}}` automáticamente.\n\nUsuarios de prueba: admin@libreria.com / Admin123! y user@libreria.com / User123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Comprueba que la API está en línea.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como administrador y guarda el token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@libreria.com\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para usarlo en las demas peticiones",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Responde con token', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como usuario normal y guarda el token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@libreria.com\",\n  \"password\": \"User123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para usarlo en las demas peticiones",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Responde con token', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea una cuenta con rol user y devuelve su token. Cambia el email si ya existe.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana López\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"Segura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para usarlo en las demas peticiones",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Responde con token', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Datos del usuario dueño del token. Requiere sesión."
          }
        }
      ]
    },
    {
      "name": "Libros",
      "item": [
        {
          "name": "Listar libros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "6"
                }
              ]
            },
            "description": "Lista paginada. Parámetros opcionales: genre (id), page, limit (1-50).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Filtrar por género",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genre=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "3"
                }
              ]
            },
            "description": "Solo libros del género indicado (id obtenido de /genres).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Detalle de libro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "6"
              ]
            },
            "description": "Detalle de un libro por id.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear libro (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Requiere token de admin. Si no se envía portada_url se genera con el ISBN (Open Library).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Emma\",\n  \"sinopsis\": \"Emma Woodhouse, joven y segura de sí misma, se empeña en arreglar la vida amorosa de quienes la rodean.\",\n  \"precio\": 199.5,\n  \"stock\": 5,\n  \"isbn\": \"9780141439587\",\n  \"anio_publicacion\": 1815,\n  \"genre_id\": 4,\n  \"author_id\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Actualizar libro (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/17",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "17"
              ]
            },
            "description": "Requiere token de admin. Solo se envían los campos a cambiar. Ajusta el id al del libro creado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 179,\n  \"stock\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar libro (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/17",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "17"
              ]
            },
            "description": "Requiere token de admin. Ajusta el id al del libro creado."
          }
        }
      ]
    },
